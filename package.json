{
  "name": "investec-card-api",
  "version": "0.3.0",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "npm run ci",
    "build": "tsup",
    "typecheck": "tsc",
    "lint": "tsc",
    "ci": "npm run build && npm run check-format && npm run check-exports && npm run typecheck && npm run test && npm audit",
    "check-exports": "attw --pack .",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "local-release": "changeset version && changeset publish"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "keywords": [
    "investec",
    "card",
    "api",
    "programmable banking",
    "open banking",
    "banking"
  ],
  "author": "Devin Pearson",
  "license": "MIT",
  "description": "A simple package for interacting with Investec's programmable banking card API",
  "repository": {
    "type": "git",
    "url": "https://github.com/devinpearson/investec-card-api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@changesets/cli": "^2.27.10",
    "@types/node": "^20.10.7",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "3.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  }
}
