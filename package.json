{
  "name": "investec-card-api",
  "version": "0.3.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "npm run ci",
    "build": "tsup",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "npm run build && npm run typecheck && npm run lint && npm run check-exports && npm run test && npm audit",
    "check-exports": "attw --pack .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:mutation": "stryker run",
    "local-release": "changeset version && changeset publish",
    "example:list-cards": "tsx examples/list-cards.ts",
    "example:upload-code": "tsx examples/upload-code.ts",
    "example:execute-code": "tsx examples/execute-code.ts",
    "example:toggle-feature": "tsx examples/toggle-feature.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "keywords": [
    "investec",
    "card",
    "api",
    "programmable banking",
    "open banking",
    "banking"
  ],
  "author": "Devin Pearson",
  "license": "MIT",
  "description": "A simple package for interacting with Investec's programmable banking card API",
  "repository": {
    "type": "git",
    "url": "https://github.com/devinpearson/investec-card-api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^2.27.10",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^20.10.7",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "^11.0.5"
    }
  }
}
